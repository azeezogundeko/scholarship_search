# AI Model Configuration
# Using Google Gemini (recommended)
AI_MODEL=gemini-1.5-pro
GOOGLE_GENAI_API_KEY=your_google_ai_studio_api_key_here

# Alternative models:
# AI_MODEL=openai:gpt-4o
# OPENAI_API_KEY=your_openai_api_key_here
# AI_MODEL=anthropic:claude-sonnet-4-0
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Custom Search API
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_custom_search_engine_id

# Brave Search API
BRAVE_API_KEY=your_brave_api_key

# Google Sheets Service Account (JSON as single line or path to file)
# Option 1: Direct JSON (escape quotes or use single line)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"..."}
# Option 2: Path to JSON file
# GOOGLE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json

# Google Sheets Configuration
DEFAULT_SHEET_ID=your_default_spreadsheet_id

# Storage Configuration
SQLITE_DB_PATH=./data/results.db
FAISS_INDEX_PATH=./data/faiss_index

# Crawl4AI Configuration
CRAWL4AI_BROWSER=chromium
CRAWL4AI_HEADLESS=true

# Scheduler Configuration
SCHEDULER_TIMEZONE=UTC

# Logging
LOG_LEVEL=INFO
